                  {%- assign first_printed = false -%}
                  {%- for v in linked_prod.variants -%}
                    {%- liquid
                      assign opt_color = v.option1 | default: v.title | strip
                      assign color_key = opt_color | downcase | append: ':::'
                      if seen_colors contains color_key
                        continue
                      endif
                      assign seen_colors = seen_colors | append: color_key

                      assign v_img = ''
                      if v.featured_image != blank
                        assign v_img = v.featured_image | image_url: width: 400
