                  { "id": "var-neon", "title": "Neon", "price": {{ base_pr | json }}, "available": true }
                {%- endif -%}
              ]
            }{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        {%- else -%}
          {
