              "id": {{ block.settings.model_id | default: block.id | json }},
              "title": {{ model_title | json }},
              "type": {{ block.settings.model_type | default: "bracelet" | json }},
              "slots": {{ block_slots | json }},
              "price": {{ linked_prod.price | default: block.settings.price | default: 4000 | json }},
              "productId": {{ linked_prod.id | json }},
              "defaultColor": {{ block.settings.default_color | default: "gold" | json }},
              "image": {{ model_img | json }},
              "variants": [
                {%- if linked_prod != blank and linked_prod.variants.size > 0 -%}
