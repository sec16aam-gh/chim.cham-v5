          "type": "text",
          "id": "model_id",
          "label": "Model ID / Key (optional)",
          "info": "e.g. original-bracelet, watch-blush-gold"
        },
        {
          "type": "number",
          "id": "price",
          "label": "Fallback Base Price (cents, used if product not linked)",
          "default": 4000
