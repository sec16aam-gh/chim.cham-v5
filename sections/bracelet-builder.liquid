                      "id": {{ v.id | json }},
                      "title": {{ opt_color | json }},
                      "price": {{ v.price | json }},
                      "available": {{ v.available | json }},
                      "sku": {{ v.sku | json }},
                      "image": {{ v_img | json }}
                    }
                    {%- assign first_printed = true -%}
                  {%- endfor -%}
                {%- else -%}
                  {%- assign base_pr = block.settings.price | default: 4000 -%}
                  { "id": "var-gold", "title": "Gold", "price": {{ base_pr | json }}, "available": true },
                  { "id": "var-silver", "title": "Silver", "price": {{ base_pr | json }}, "available": true },
