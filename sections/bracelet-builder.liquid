                  when 'watch-pearly-silver'
                    assign model_img = 'watch-pearly-silver.png' | asset_url
                  when 'watch-sky-blue'
                    assign model_img = 'watch-sky-blue.png' | asset_url
                  when 'original-bracelet'
                    assign model_img = 'bracelet-silver.png' | asset_url
                endcase
              endif
              assign block_slots = block.settings.slots_count | default: 16
              if block.settings.model_type == 'watch'
                assign remainder = block_slots | modulo: 2
                if remainder != 0
                  assign block_slots = block_slots | plus: 1
                endif
              endif
