              elsif linked_prod.featured_image != blank
                assign model_img = linked_prod.featured_image | image_url: width: 400
              else
                case block.settings.model_id
                  when 'watch-blush-gold'
                    assign model_img = 'watch-blush-gold.png' | asset_url
                  when 'watch-blush-silver'
                    assign model_img = 'watch-blush-silver.png' | asset_url
                  when 'watch-flower'
                    assign model_img = 'watch-flower.png' | asset_url
                  when 'watch-fuchsia'
                    assign model_img = 'watch-fuchsia.png' | asset_url
                  when 'watch-glittery'
                    assign model_img = 'watch-glittery.png' | asset_url
                  when 'watch-lilac-gold'
