{% comment %}
  ------------------------------------------------------------------------------
  CUSTOM BRACELET & WATCH BUILDER SECTION
  ------------------------------------------------------------------------------
{% endcomment %}

{{ 'bracelet-builder.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign section_id = section.id
  assign charms_collection = section.settings.charms_collection
  assign charm_products = section.settings.charm_product_list
  assign meta_products = page.metafields.custom.charm_products.value | default: product.metafields.custom.charm_products.value

  assign currency_code = cart.currency.iso_code | default: 'KWD'
  assign currency_symbol = currency_code
  assign brand_mark = section.settings.brand_mark | default: 'CC'
  assign brand_name = section.settings.brand_name | default: 'CHIM.CHAM'
-%}

<div class="customstyle{{ section_id }} bracelet-builder-section-wrap" id="bracelet-builder-section-{{ section_id }}">
  <style>
    #bracelet-builder-section-{{ section_id }} {
      --bb-text-primary: #FE80BC;
      --bb-text-secondary: #FFA2D2;
      --bb-text-muted: #FFB8DE;
      --bb-accent-purple: #BC90D5;
      --bb-accent-purple-hover: #AA7AC5;
      --bb-btn-bg: #FE80BC;
      --bb-btn-text: #ffffff;
      --bb-btn-hover: #E76FA7;
      --bb-link-silver: url('{{ 'bracelet-silver.png' | asset_url }}');
      --bb-link-gold: url('{{ 'bracelet-gold.png' | asset_url }}');
      --bb-link-rose: url('{{ 'bracelet-rose-gold.png' | asset_url }}');
      --bb-link-black: url('{{ 'bracelet-black.png' | asset_url }}');
      --bb-swatch-gold: {{ section.settings.swatch_gold | default: '#d4a748' }};
      --bb-swatch-silver: {{ section.settings.swatch_silver | default: '#d9dcdb' }};
      --bb-swatch-mixed: {{ section.settings.swatch_mixed | default: 'linear-gradient(135deg, #d4a748 50%, #d9dcdb 50%)' }};
      --bb-swatch-purple: {{ section.settings.swatch_purple | default: '#8a4fff' }};
      --bb-swatch-black: {{ section.settings.swatch_black | default: '#222224' }};
      --bb-swatch-red: {{ section.settings.swatch_red | default: '#d92534' }};
      --bb-swatch-blue: {{ section.settings.swatch_blue | default: '#2563eb' }};
      --bb-swatch-champagne: {{ section.settings.swatch_champagne | default: '#e8d8b0' }};
      --bb-swatch-neon: {{ section.settings.swatch_neon | default: '#39ff14' }};
    }
    @media (max-width: 991px) {
      #bracelet-builder-section-{{ section_id }} .bb-sidebar-scroll-spacer,
      #bracelet-builder-section-{{ section_id }} .bb-charms-list-spacer {
        display: block !important;
        width: 100% !important;
        height: 5px !important;
        min-height: 5px !important;
        flex-shrink: 0 !important;
        pointer-events: none !important;
      }
      #bracelet-builder-section-{{ section_id }} .bb-charms-list-container {
        padding-bottom: 5px !important;
      }
      #bracelet-builder-section-{{ section_id }} .bb-charms-row:last-child {
        margin-bottom: 4px !important;
      }
    }
  </style>
  {%- render 'style-section' -%}
  <div class="{{ section.settings.setwidth | default: 'container' }}">
    <div class="bracelet-builder-app" 
         id="bracelet-builder-{{ section_id }}" 
         data-bracelet-builder-section 
         data-section-id="{{ section_id }}">

  {%- comment -%} ================= MAIN LAYOUT ================= {%- endcomment -%}
  <div class="bb-layout">
    
    {%- comment -%} ----- LEFT / CENTER COLUMN ----- {%- endcomment -%}
    <main class="bb-main-content">
      
      {%- comment -%} WORKBENCH & CANVAS {%- endcomment -%}
      <section class="bb-workbench" aria-label="Bracelet canvas">
        <div class="bb-workbench-toolbar">
          
          <!-- Mobile Expandable Model & Color Header Bar -->
          <div class="bb-mobile-model-bar">
            <button class="bb-mobile-summary-btn" type="button" data-mobile-expand-btn aria-expanded="false" aria-label="Toggle bracelet model and color options">
              <div class="bb-mobile-summary-left">
                <span class="bb-mobile-summary-icon">
                  <span class="bb-swatch swatch-silver"></span>
                </span>
                <span class="bb-mobile-summary-title">Original Bracelet · Silver</span>
              </div>
              <div class="bb-mobile-summary-right">
                <span class="bb-mobile-summary-badge">Change</span>
                <svg class="bb-chevron" aria-hidden="true" fill="none" viewBox="0 0 24 24"><path d="m7 9.5 5 5 5-5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"></path></svg>
              </div>
            </button>
          </div>

          <div class="bb-toolbar-group" data-model-color-group>
            
            {%- comment -%} 1. Bracelet Model Dropdown {%- endcomment -%}
            <div class="bb-select-wrap">
              <button class="bb-pill-btn" type="button" data-model-btn aria-expanded="false">
                <span class="bb-swatch swatch-silver"></span>
                <span>Original Bracelet</span>
                <svg class="bb-chevron" aria-hidden="true" fill="none" viewBox="0 0 24 24"><path d="m7 9.5 5 5 5-5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"></path></svg>
              </button>

              <div class="bb-dropdown-menu" data-model-menu>
                {%- assign model_blocks = section.blocks | where: 'type', 'bracelet_model' -%}
                {%- if model_blocks.size > 0 -%}
                  {%- for block in model_blocks -%}
                    {%- liquid
                      assign linked_prod = block.settings.linked_product
                      assign model_title = block.settings.title | default: linked_prod.title | default: 'Original Bracelet'
                      assign model_price = linked_prod.price | default: block.settings.price | default: 2499
                      assign slots_num = block.settings.slots_count | default: 16
                      assign block_thumb = block.settings.model_image
                      if block_thumb == blank
                        if linked_prod.featured_image != blank
                          assign block_thumb_url = linked_prod.featured_image | image_url: width: 64
                        else
                          case block.settings.model_id
                            when 'watch-blush-gold'
                              assign block_thumb_url = 'watch-blush-gold.png' | asset_url
                            when 'watch-blush-silver'
                              assign block_thumb_url = 'watch-blush-silver.png' | asset_url
                            when 'watch-flower'
                              assign block_thumb_url = 'watch-flower.png' | asset_url
                            when 'watch-fuchsia'
                              assign block_thumb_url = 'watch-fuchsia.png' | asset_url
                            when 'watch-glittery'
                              assign block_thumb_url = 'watch-glittery.png' | asset_url
                            when 'watch-lilac-gold'
                              assign block_thumb_url = 'watch-lilac-gold.png' | asset_url
                            when 'watch-lilac-silver'
                              assign block_thumb_url = 'watch-lilac-silver.png' | asset_url
                            when 'watch-pearly-gold'
                              assign block_thumb_url = 'watch-pearly-gold.png' | asset_url
                            when 'watch-pearly-silver'
                              assign block_thumb_url = 'watch-pearly-silver.png' | asset_url
                            when 'watch-sky-blue'
                              assign block_thumb_url = 'watch-sky-blue.png' | asset_url
                            when 'original-bracelet'
                              assign block_thumb_url = 'bracelet-silver.png' | asset_url
                            else
                              assign block_thumb_url = ''
                          endcase
                        endif
                      else
                        assign block_thumb_url = block_thumb | image_url: width: 64
                      endif
                    -%}
                    <button type="button" 
                            class="bb-dropdown-item {% if forloop.first %}is-active{% endif %}" 
                            data-model-id="{{ block.settings.model_id | default: block.id }}">
                      <div class="bb-item-left">
                        {%- if block_thumb_url != blank -%}
                          <span class="bb-pill-icon" style="background-image: url('{{ block_thumb_url }}');"></span>
                        {%- else -%}
                          <span class="bb-swatch swatch-{{ block.settings.default_color | default: 'silver' }}"></span>
                        {%- endif -%}
                        <div class="bb-item-meta">
                          <span class="bb-item-title">{{ model_title }}</span>
                          <span class="bb-item-sub">{{ slots_num }} charm positions</span>
                        </div>
                      </div>
                      <span class="bb-item-price">{{ model_price | money }}</span>
                    </button>
                  {%- endfor -%}
                {%- else -%}
                  {%- comment -%} Default Models Presets {%- endcomment -%}
                  <button type="button" class="bb-dropdown-item is-active" data-model-id="original-bracelet">
                    <div class="bb-item-left">
                      <span class="bb-pill-icon" style="background-image: url('{{ 'bracelet-silver.png' | asset_url }}');"></span>
                      <div class="bb-item-meta">
                        <span class="bb-item-title">Original Bracelet</span>
                        <span class="bb-item-sub">16 charm positions</span>
                      </div>
                    </div>
                    <span class="bb-item-price">4.000 {{ currency_code }}</span>
                  </button>
                  <button type="button" class="bb-dropdown-item" data-model-id="watch-blush-gold">
                    <div class="bb-item-left">
                      <span class="bb-pill-icon" style="background-image: url('{{ 'watch-blush-gold.png' | asset_url }}');"></span>
                      <div class="bb-item-meta">
                        <span class="bb-item-title">Blush Gold</span>
                        <span class="bb-item-sub">14 charm positions</span>
                      </div>
                    </div>
                    <span class="bb-item-price">9.500 {{ currency_code }}</span>
                  </button>
                  <button type="button" class="bb-dropdown-item" data-model-id="watch-blush-silver">
                    <div class="bb-item-left">
                      <span class="bb-pill-icon" style="background-image: url('{{ 'watch-blush-silver.png' | asset_url }}');"></span>
                      <div class="bb-item-meta">
                        <span class="bb-item-title">Blush Silver</span>
                        <span class="bb-item-sub">14 charm positions</span>
                      </div>
                    </div>
                    <span class="bb-item-price">8.500 {{ currency_code }}</span>
                  </button>
                  <button type="button" class="bb-dropdown-item" data-model-id="watch-flower">
                    <div class="bb-item-left">
                      <span class="bb-pill-icon" style="background-image: url('{{ 'watch-flower.png' | asset_url }}');"></span>
                      <div class="bb-item-meta">
                        <span class="bb-item-title">Flower</span>
                        <span class="bb-item-sub">14 charm positions</span>
                      </div>
                    </div>
                    <span class="bb-item-price">8.500 {{ currency_code }}</span>
                  </button>
                  <button type="button" class="bb-dropdown-item" data-model-id="watch-fuchsia">
                    <div class="bb-item-left">
                      <span class="bb-pill-icon" style="background-image: url('{{ 'watch-fuchsia.png' | asset_url }}');"></span>
                      <div class="bb-item-meta">
                        <span class="bb-item-title">Fuchsia</span>
                        <span class="bb-item-sub">14 charm positions</span>
                      </div>
                    </div>
                    <span class="bb-item-price">8.500 {{ currency_code }}</span>
                  </button>
                  <button type="button" class="bb-dropdown-item" data-model-id="watch-glittery">
                    <div class="bb-item-left">
                      <span class="bb-pill-icon" style="background-image: url('{{ 'watch-glittery.png' | asset_url }}');"></span>
                      <div class="bb-item-meta">
                        <span class="bb-item-title">Glittery</span>
                        <span class="bb-item-sub">14 charm positions</span>
                      </div>
                    </div>
                    <span class="bb-item-price">9.500 {{ currency_code }}</span>
                  </button>
                  <button type="button" class="bb-dropdown-item" data-model-id="watch-lilac-gold">
                    <div class="bb-item-left">
                      <span class="bb-pill-icon" style="background-image: url('{{ 'watch-lilac-gold.png' | asset_url }}');"></span>
                      <div class="bb-item-meta">
                        <span class="bb-item-title">Lilac Gold</span>
                        <span class="bb-item-sub">14 charm positions</span>
                      </div>
                    </div>
                    <span class="bb-item-price">9.500 {{ currency_code }}</span>
                  </button>
                  <button type="button" class="bb-dropdown-item" data-model-id="watch-lilac-silver">
                    <div class="bb-item-left">
                      <span class="bb-pill-icon" style="background-image: url('{{ 'watch-lilac-silver.png' | asset_url }}');"></span>
                      <div class="bb-item-meta">
                        <span class="bb-item-title">Lilac Silver</span>
                        <span class="bb-item-sub">14 charm positions</span>
                      </div>
                    </div>
                    <span class="bb-item-price">8.500 {{ currency_code }}</span>
                  </button>
                  <button type="button" class="bb-dropdown-item" data-model-id="watch-pearly-gold">
                    <div class="bb-item-left">
                      <span class="bb-pill-icon" style="background-image: url('{{ 'watch-pearly-gold.png' | asset_url }}');"></span>
                      <div class="bb-item-meta">
                        <span class="bb-item-title">Pearly Gold</span>
                        <span class="bb-item-sub">14 charm positions</span>
                      </div>
                    </div>
                    <span class="bb-item-price">9.500 {{ currency_code }}</span>
                  </button>
                  <button type="button" class="bb-dropdown-item" data-model-id="watch-pearly-silver">
                    <div class="bb-item-left">
                      <span class="bb-pill-icon" style="background-image: url('{{ 'watch-pearly-silver.png' | asset_url }}');"></span>
                      <div class="bb-item-meta">
                        <span class="bb-item-title">Pearly Silver</span>
                        <span class="bb-item-sub">14 charm positions</span>
                      </div>
                    </div>
                    <span class="bb-item-price">8.500 {{ currency_code }}</span>
                  </button>
                  <button type="button" class="bb-dropdown-item" data-model-id="watch-sky-blue">
                    <div class="bb-item-left">
                      <span class="bb-pill-icon" style="background-image: url('{{ 'watch-sky-blue.png' | asset_url }}');"></span>
                      <div class="bb-item-meta">
                        <span class="bb-item-title">Sky Blue</span>
                        <span class="bb-item-sub">14 charm positions</span>
                      </div>
                    </div>
                    <span class="bb-item-price">8.500 {{ currency_code }}</span>
                  </button>
                {%- endif -%}
              </div>
            </div>

            {%- comment -%} 2. Color Dropdown {%- endcomment -%}
            <div class="bb-select-wrap" data-color-select-wrap>
              <button class="bb-pill-btn" type="button" data-color-btn aria-expanded="false">
                <span class="bb-swatch swatch-silver"></span>
                <span>Color: Silver</span>
                <svg class="bb-chevron" aria-hidden="true" fill="none" viewBox="0 0 24 24"><path d="m7 9.5 5 5 5-5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"></path></svg>
              </button>

              <div class="bb-dropdown-menu" data-color-menu>
                {%- comment -%} Dynamically populated by JS from selected base product variants {%- endcomment -%}
                <button type="button" class="bb-dropdown-item" data-color-id="gold">
                  <div class="bb-item-left">
                    <span class="bb-swatch swatch-gold"></span>
                    <span class="bb-item-title">Gold</span>
                  </div>
                  <span class="bb-item-price">4.000 {{ currency_code }}</span>
                </button>
                <button type="button" class="bb-dropdown-item is-active" data-color-id="silver">
                  <div class="bb-item-left">
                    <span class="bb-swatch swatch-silver"></span>
                    <span class="bb-item-title">Silver</span>
                  </div>
                  <span class="bb-item-price">4.000 {{ currency_code }}</span>
                </button>
                <button type="button" class="bb-dropdown-item" data-color-id="mixed">
                  <div class="bb-item-left">
                    <span class="bb-swatch swatch-mixed"></span>
                    <span class="bb-item-title">Mixed Gold x Silver</span>
                  </div>
                  <span class="bb-item-price">4.000 {{ currency_code }}</span>
                </button>
                <button type="button" class="bb-dropdown-item" data-color-id="purple">
                  <div class="bb-item-left">
                    <span class="bb-swatch swatch-purple"></span>
                    <span class="bb-item-title">Purple</span>
                  </div>
                  <span class="bb-item-price">4.000 {{ currency_code }}</span>
                </button>
                <button type="button" class="bb-dropdown-item" data-color-id="black">
                  <div class="bb-item-left">
                    <span class="bb-swatch swatch-black"></span>
                    <span class="bb-item-title">Black</span>
                  </div>
                  <span class="bb-item-price">4.000 {{ currency_code }}</span>
                </button>
                <button type="button" class="bb-dropdown-item" data-color-id="red">
                  <div class="bb-item-left">
                    <span class="bb-swatch swatch-red"></span>
                    <span class="bb-item-title">Red</span>
                  </div>
                  <span class="bb-item-price">4.000 {{ currency_code }}</span>
                </button>
                <button type="button" class="bb-dropdown-item" data-color-id="blue">
                  <div class="bb-item-left">
                    <span class="bb-swatch swatch-blue"></span>
                    <span class="bb-item-title">Blue</span>
                  </div>
                  <span class="bb-item-price">4.000 {{ currency_code }}</span>
                </button>
                <button type="button" class="bb-dropdown-item" data-color-id="champagne">
                  <div class="bb-item-left">
                    <span class="bb-swatch swatch-champagne"></span>
                    <span class="bb-item-title">Champagne</span>
                  </div>
                  <span class="bb-item-price">4.000 {{ currency_code }}</span>
                </button>
                <button type="button" class="bb-dropdown-item" data-color-id="neon">
                  <div class="bb-item-left">
                    <span class="bb-swatch swatch-neon"></span>
                    <span class="bb-item-title">Neon</span>
                  </div>
                  <span class="bb-item-price">4.000 {{ currency_code }}</span>
                </button>
              </div>
            </div>

          </div>

          {%- comment -%} Toolbar Actions: Search, Reset, Help {%- endcomment -%}
          <div class="bb-workbench-actions">
            
            <div class="bb-search-control" data-search-control>
              <button class="bb-search-toggle-btn" type="button" data-search-toggle-btn aria-label="Search charms" title="Search charms">
                <svg class="bb-search-icon" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="11" cy="11" r="8"></circle>
                  <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
              </button>
              <input type="text" 
                     class="bb-search-input" 
                     placeholder="{{ section.settings.search_placeholder | default: 'Search charms...' }}" 
                     data-search-input 
                     aria-label="Search charms">
              <button class="bb-search-clear" data-search-clear type="button" aria-label="Clear search">&times;</button>
            </div>

            <button class="bb-action-btn" type="button" data-reset-btn title="Reset Design">
              <span>{{ section.settings.reset_label | default: 'Reset' }}</span>
              <svg class="bb-action-icon" aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
                <path d="M3 3v5h5"></path>
              </svg>
            </button>

            <button class="bb-circle-btn" type="button" data-help-btn aria-label="How it works" title="How it works">
              <svg class="bb-help-icon" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
                <line x1="12" y1="17" x2="12.01" y2="17"></line>
              </svg>
            </button>

          </div>

        </div>

        {%- comment -%} CANVAS & BRACELET LINKS {%- endcomment -%}
        <div class="bb-canvas-container">
          <div class="bb-bracelet-scroll-wrap">
            <div class="bb-bracelet-row metal-silver" data-bracelet-row>
              {%- comment -%} Slots injected dynamically by JS {%- endcomment -%}
            </div>
          </div>
        </div>

      </section>

      {%- comment -%} CHARMS CATALOG SECTION {%- endcomment -%}
      <section class="bb-catalog-section" aria-label="Charm catalog">
        
        <div class="bb-catalog-toolbar">
          
          <div class="bb-filter-actions">
            
            {%- comment -%} Theme Filter {%- endcomment -%}
            <div class="bb-select-wrap">
              <button class="bb-filter-btn" type="button" data-theme-filter-btn aria-expanded="false">
                Theme
                <svg aria-hidden="true" fill="none" height="14" viewBox="0 0 24 24" width="14"><path d="m7 9.5 5 5 5-5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
              </button>

              <div class="bb-filter-popover" data-theme-popover>
                <div class="bb-filter-title">{{ section.settings.theme_filter_title | default: 'Shop by Story' }}</div>
                <div class="bb-filter-grid-2col">
                  {%- assign themes_list = "Friendship,Lucky,Travel,Sports,Zodiac,Family,Animals,Love,Nature,Food & Drink,Music,Birthday,Symbols,Positive,Lifestyle" | split: "," -%}
                  {%- for theme_name in themes_list -%}
                    <label class="bb-checkbox-label">
                      <input type="checkbox" value="{{ theme_name }}">
                      <span>{{ theme_name }}</span>
                    </label>
                  {%- endfor -%}
                </div>
              </div>
            </div>

            {%- comment -%} Charms Color Filter {%- endcomment -%}
            <div class="bb-select-wrap">
              <button class="bb-filter-btn" type="button" data-color-filter-btn aria-expanded="false">
                Charms Color
                <svg aria-hidden="true" fill="none" height="14" viewBox="0 0 24 24" width="14"><path d="m7 9.5 5 5 5-5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
              </button>

              <div class="bb-filter-popover" data-color-popover>
                <div class="bb-filter-title">{{ section.settings.color_filter_title | default: 'Choose a finish' }}</div>
                <div>
                  <label class="bb-checkbox-label">
                    <input type="checkbox" value="Silver">
                    <span class="bb-swatch swatch-silver"></span>
                    <span>Silver</span>
                  </label>
                  <label class="bb-checkbox-label">
                    <input type="checkbox" value="Gold">
                    <span class="bb-swatch swatch-gold"></span>
                    <span>Gold</span>
                  </label>
                  <label class="bb-checkbox-label">
                    <input type="checkbox" value="Rose Gold">
                    <span class="bb-swatch swatch-rose"></span>
                    <span>Rose Gold</span>
                  </label>
                  <label class="bb-checkbox-label">
                    <input type="checkbox" value="Black">
                    <span class="bb-swatch swatch-black"></span>
                    <span>Black</span>
                  </label>
                </div>
              </div>
            </div>

            <button class="bb-clear-filters-btn" type="button" data-clear-filters-btn style="display: none;">
              {{ section.settings.clear_filters_label | default: 'Clear filters' }} &times;
            </button>

          </div>

          <div class="bb-catalog-toolbar-meta">
            {%- assign initial_charms_count = charms_collection.all_products_count | default: charm_products.count | default: 74 -%}
            <span class="bb-catalog-count" data-catalog-count>{{ initial_charms_count }} charms</span>
            <span class="bb-catalog-meta-dot">•</span>
            <span class="bb-catalog-drag-text">{{ section.settings.drag_instruction | default: 'Drag to place · tap to preview' }}</span>
          </div>

        </div>

        {%- comment -%} CHARMS GRID {%- endcomment -%}
        <div class="bb-charm-grid" data-catalog-grid>
          {%- comment -%} Hydrated dynamically by JS {%- endcomment -%}
        </div>

      </section>

    </main>

    {%- comment -%} ----- RIGHT SIDEBAR (SUMMARY & CART) ----- {%- endcomment -%}
    <aside class="bb-sidebar" aria-label="Order summary">
      
      <!-- Mobile Drawer Header -->
      <div class="bb-sidebar-drawer-header">
