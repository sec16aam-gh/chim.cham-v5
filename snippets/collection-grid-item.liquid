      </a>
    </h4>
    {%- if custom_count != blank -%}
    <p class="text-theme collection-count "> {{ custom_count }}
    </p>
    {%- elsif featured_collection != blank and hide_counts != true -%}
    <p class="text-theme collection-count "> {{ featured_collection.products_count }}
    </p>
    {%- endif -%}
  </div>
</div>