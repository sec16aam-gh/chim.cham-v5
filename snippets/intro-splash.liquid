    document.documentElement.style.overflow = 'hidden';
    document.body.style.overflow = 'hidden';

    // Auto-dismiss after duration
    var timer = setTimeout(dismissSplash, SPLASH_DURATION);

    // Also allow click/tap to dismiss early
    splash.addEventListener('click', function () {
      clearTimeout(timer);
      dismissSplash();
    });
    splash.addEventListener('touchend', function () {
      clearTimeout(timer);
      dismissSplash();
    });

    // Dismiss as soon as the page is fully interactive (DOMContentLoaded or load)
    // but wait at least SPLASH_DURATION for the animation to shine
    var pageReady = false;
    function onPageReady() {
      if (pageReady) return;
      pageReady = true;
      // If page loaded quickly, keep showing until SPLASH_DURATION at minimum
      // (timer already set above — no action needed)
    }
    document.addEventListener('DOMContentLoaded', onPageReady);
    window.addEventListener('load', onPageReady);
  })();
</script>
