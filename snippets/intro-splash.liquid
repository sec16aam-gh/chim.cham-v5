<style>
  /* ============================================================
   CHIM CHAM — Intro Splash Screen
   ============================================================ */
  #chimcham-splash {
    position: fixed;
    inset: 0;
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #ff85c2;
    overflow: hidden;
    transition: opacity 0.6s ease, visibility 0.6s ease;
  }

  /* Hide once dismissed */
  #chimcham-splash.splash-hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  /* Animated background gradient */
  #chimcham-splash::before {
    content: '';
    position: absolute;
    inset: -50%;
    background: radial-gradient(circle at 30% 40%, #ffaad8 0%, #ff85c2 35%, #ff5fab 70%, #e83a96 100%);
    animation: splashBgRotate 6s linear infinite;
  }

  @keyframes splashBgRotate {
    0% {
      transform: rotate(0deg) scale(1.2);
    }
    100% {
      transform: rotate(360deg) scale(1.2);
    }
  }

  /* Floating background hearts */
  .splash-heart {
    position: absolute;
    opacity: 0;
    animation: floatHeart linear infinite;
    pointer-events: none;
  }

  @keyframes floatHeart {
    0% {
      transform: translateY(110vh) scale(0.5) rotate(0deg);
      opacity: 0;
    }
    10% {
      opacity: 0.35;
    }
    90% {
      opacity: 0.2;
    }
    100% {
      transform: translateY(-20vh) scale(1.1) rotate(20deg);
      opacity: 0;
    }
  }

  /* -------- Logo wrapper -------- */
  .splash-logo-wrap {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    animation: logoEntrance 0.9s cubic-bezier(0.34, 1.56, 0.64, 1) 0.3s both;
  }

  @keyframes logoEntrance {
    0% {
      transform: scale(0.3) rotate(-8deg);
      opacity: 0;
    }
    60% {
      transform: scale(1.08) rotate(2deg);
      opacity: 1;
    }
    80% {
      transform: scale(0.96) rotate(-1deg);
    }
    100% {
      transform: scale(1) rotate(0deg);
      opacity: 1;
    }
  }

  /* SVG logo itself */
  .splash-logo-svg {
    width: min(320px, 75vw);
    height: auto;
    filter: drop-shadow(0 8px 24px rgba(176, 30, 100, 0.45));
    animation: logoPulse 2.2s ease-in-out 1.2s infinite alternate;
  }

  @keyframes logoPulse {
    0% {
      filter: drop-shadow(0 8px 24px rgba(176, 30, 100, 0.45));
    }
    100% {
      filter: drop-shadow(0 12px 36px rgba(176, 30, 100, 0.7)) brightness(1.05);
    }
  }

  /* -------- Sparkle particles -------- */
  .splash-sparkles {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 3;
  }

  .sparkle {
    position: absolute;
    opacity: 0;
    animation: sparkleAnim ease-in-out infinite;
  }

  /* 4-point star shape via SVG polygon */
  .sparkle svg {
    width: 100%;
    height: 100%;
  }

  @keyframes sparkleAnim {
    0% {
      opacity: 0;
      transform: scale(0) rotate(0deg);
    }
    20% {
      opacity: 1;
      transform: scale(1) rotate(45deg);
    }
    50% {
      opacity: 0.8;
      transform: scale(1.2) rotate(90deg);
    }
    80% {
      opacity: 0.4;
      transform: scale(0.8) rotate(135deg);
    }
    100% {
      opacity: 0;
      transform: scale(0) rotate(180deg);
    }
  }

  /* -------- Shine sweep across whole screen -------- */
  .splash-shine {
    position: absolute;
    top: -50%;
    left: -150%;
    width: 150%;
    height: 200%;
    background: linear-gradient(
      105deg,
      rgba(255, 255, 255, 0) 0%,
      rgba(255, 255, 255, 0.05) 35%,
      rgba(255, 255, 255, 0.3) 50%,
      rgba(255, 255, 255, 0.05) 65%,
      rgba(255, 255, 255, 0) 100%
    );
    transform: skewX(-25deg);
    animation: shineSweep 6s ease-in-out infinite;
    z-index: 10;
    pointer-events: none;
  }

  @keyframes shineSweep {
    0% {
      left: -150%;
      opacity: 0;
    }
    20% {
      opacity: 1;
    }
    80% {
      opacity: 1;
    }
    100% {
      left: 100%;
      opacity: 0;
    }
  }

  /* -------- Progress dots -------- */
  .splash-dots {
    display: flex;
    gap: 8px;
    margin-top: 28px;
    animation: dotsAppear 0.5s ease 1.2s both;
  }

  @keyframes dotsAppear {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .splash-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.5);
    animation: dotBounce 1.4s ease-in-out infinite;
  }
  .splash-dot:nth-child(1) {
    animation-delay: 0s;
    background: #fff;
  }
  .splash-dot:nth-child(2) {
    animation-delay: 0.2s;
  }
  .splash-dot:nth-child(3) {
    animation-delay: 0.4s;
  }

  @keyframes dotBounce {
    0%,
    80%,
    100% {
      transform: scale(1);
    }
    40% {
      transform: scale(1.5);
      background: #fff;
    }
  }

  /* -------- Tagline text -------- */
  .splash-tagline {
    margin-top: 14px;
    font-family: 'Georgia', serif;
    font-style: italic;
    font-size: clamp(13px, 2.5vw, 17px);
    color: rgba(255, 255, 255, 0.85);
    letter-spacing: 2px;
    text-shadow: 0 2px 8px rgba(176, 30, 100, 0.4);
    animation: taglineAppear 0.7s ease 1.5s both;
  }

  @keyframes taglineAppear {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* -------- Responsive -------- */
  @media (max-width: 480px) {
    .splash-logo-svg {
      width: min(260px, 80vw);
    }
  }
</style>

