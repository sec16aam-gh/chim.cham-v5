{% layout none %}
{%- paginate collection.products by 250 -%}
{
  "page": {{ paginate.current_page | json }},
  "pages": {{ paginate.pages | json }},
  "total": {{ paginate.items | json }},
  "charms": [
    {%- for prod in collection.products -%}
      {%- liquid
        assign charm_type = prod.metafields.custom.charm_type | default: 'simple'
        assign charm_slots = prod.metafields.custom.slots_count | default: 1
        assign charm_theme = prod.metafields.custom.theme | default: ''
        assign charm_color = prod.metafields.custom.color | default: ''

        for tag in prod.tags
          assign tag_lower = tag | downcase
          if tag_lower contains 'theme:'
            assign charm_theme = tag | split: ':' | last | strip
          elsif tag_lower contains 'color:'
            assign charm_color = tag | split: ':' | last | strip
          elsif tag_lower contains 'type:drop' or tag_lower == 'drop'
            assign charm_type = 'drop'
          elsif tag_lower contains 'type:2-links' or tag_lower == '2-links' or tag_lower == 'double'
            assign charm_type = 'double'
            assign charm_slots = 2
          elsif tag_lower == 'type:chain' or tag_lower == 'type: chain'
            assign charm_type = 'chain'
            assign charm_slots = 4
          endif
        endfor

        assign title_lower = prod.title | downcase
        if title_lower contains 'bows'
          assign charm_type = 'double'
          assign charm_slots = 2
        elsif title_lower contains 'letter ' or title_lower contains 'melted heart' or title_lower contains 'pink stone' or title_lower contains 'cinderella'
          assign charm_type = 'drop'
        elsif title_lower contains 'crystal heart'
          unless title_lower contains 'gold'
            assign charm_type = 'drop'
          endunless
        elsif title_lower contains 'lunar glow'
          assign charm_color_lower = charm_color | downcase
          assign has_silver_tag = false
          for tag in prod.tags
            assign t_low = tag | downcase
            if t_low contains 'silver'
              assign has_silver_tag = true
            endif
          endfor
          if charm_color_lower contains 'silver' or has_silver_tag
            assign charm_type = 'drop'
          elsif charm_color_lower contains 'gold'
            # keep default
          elsif prod.price > 1000 or prod.price > 1.1
            assign charm_type = 'drop'
          endif
        endif

        assign prod_img = ''
        if prod.featured_image != blank
          assign prod_img = prod.featured_image | image_url: width: 300
        endif

        assign prod_var_id = prod.selected_or_first_available_variant.id | default: prod.variants.first.id | default: prod.id
      -%}
      {
        "id": {{ prod.id | json }},
        "title": {{ prod.title | json }},
        "price": {{ prod.price | json }},
        "image": {{ prod_img | json }},
        "description": {{ prod.description | strip_html | truncate: 140 | json }},
        "theme": {{ charm_theme | json }},
        "color": {{ charm_color | json }},
        "type": {{ charm_type | json }},
        "slots": {{ charm_slots | json }},
        "tags": {{ prod.tags | json }},
        "variantId": {{ prod_var_id | json }}
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
}
{%- endpaginate -%}
